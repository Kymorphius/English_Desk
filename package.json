{
  "name": "english-desk-clean",
  "productName": "English Desk Studio",
  "version": "0.2.8",
  "private": true,
  "description": "Independent IELTS writing and speaking practice",
  "author": "Vienky",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win nsis",
    "preview": "node scripts/serve.cjs",
    "build:native": "node scripts/build-native.cjs",
    "prestart": "npm run build:native",
    "predist:mac": "npm run build:native",
    "prepack": "npm run build:native"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "node-api-headers": "^1.9.0"
  },
  "build": {
    "appId": "com.vienky.englishdesk.studio",
    "productName": "English Desk Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "data/**/*",
      "package.json",
      "native/macos/*.node"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "\u5f55\u5236\u53e3\u8bed\u7ec3\u4e60\uff0c\u53ea\u6709\u70b9\u51fb\u8f6c\u5199\u65f6\u624d\u53d1\u9001\u5230\u4f60\u914d\u7f6e\u7684\u670d\u52a1\u3002"
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "asarUnpack": [
      "native/macos/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "Vienky",
      "repo": "English_Desk",
      "releaseType": "release"
    },
    "artifactName": "English-Desk-Studio-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
